{
  "schema_version": 1,
  "arms": ["bpe", "superbpe", "parity"],
  "official_pipeline": {
    "superbpe_repo": "https://github.com/PythonNut/superbpe.git",
    "superbpe_commit": "bbd09768fc28a875cef48e6bdd66e3a17454628e",
    "tokenizers_repo": "https://github.com/alisawuffles/tokenizers-superbpe.git",
    "tokenizers_commit": "757f2a55c0820ed47064e1fe473deea39b7b611b"
  },
  "parity_pipeline": {
    "pretok": "official_stage1",
    "merge_selection": "parity_fair_max_worst_cr_dev",
    "entrypoint": "scripts/run_parity_tokenizer_benchmark.py",
    "cr_dev": "equal-N FLORES parallel dev + AmericasNLP/reserved nah/yua (build_plan_a_cr_dev.py)"
  },
  "projection_bytes": 10000000000,
  "shared_premium_formula": "(r_bpe * r_superbpe * r_parity) ** (1/3)",
  "tiers": {
    "smoke": {
      "corpus_bytes": 10000000,
      "vocab_size": 4096,
      "transition_vocab_size": 3072,
      "max_rss_gb": 8,
      "min_available_gb": 2
    },
    "pilot": {
      "corpus_bytes": 100000000,
      "vocab_size": 16000,
      "transition_vocab_size": 12000,
      "max_rss_gb": 20,
      "min_available_gb": 3
    },
    "scale": {
      "corpus_bytes": 1000000000,
      "vocab_size": 100000,
      "transition_vocab_size": 80000,
      "max_rss_gb": 26,
      "min_available_gb": 4
    }
  },
  "notes": [
    "Run tiers in order and stop after any OOM guard or failed verification.",
    "Train the tokenizer triplet on the same corpus manifest before premium calibration.",
    "Runtime projections are linear estimates; memory must be measured at every tier.",
    "The final 10 GB tokenizer runs belong on measured high-memory AWS CPU jobs."
  ]
}
